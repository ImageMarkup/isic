{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>kitware-resonant/.github:renovate-project.json5',
  ],
  packageRules: [
    {
      matchPackageNames: ['django-oauth-toolkit'],
      // v2 removed OOB support: https://github.com/jazzband/django-oauth-toolkit/pull/1124
      allowedVersions: '<2.0.0',
    },
    {
      matchPackageNames: ['gdal'],
      enabled: false,
    },
    {
      matchPackageNames: ['mypy'],
      allowedVersions: '<1.20',
    },
    {
      matchPackageNames: ['pyparsing'],
      // 3.3.3 has an infix_notation regression: https://github.com/pyparsing/pyparsing/issues/672
      allowedVersions: '!/^3\\.3\\.3$/',
    },
  ],
}
