{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>kitware-resonant/.github:renovate-project.json5',
    // These customManagers allow Renovate to update "*_VERSION" variables annotated with
    // a "# renovate:" comment, to support Greenmask updates.
    'customManagers:dockerfileVersions',
    'customManagers:githubActionsVersions',
  ],
  packageRules: [
    {
      matchDepNames: ['GreenmaskIO/greenmask'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'dev dependencies',
      groupSlug: 'dev-deps',
    },
    {
      // Wait for upstream support from Resonant
      matchPackageNames: ['celery'],
      enabled: false,
    },
    {
      matchPackageNames: ['django-oauth-toolkit'],
      // v2 removed OOB support: https://github.com/jazzband/django-oauth-toolkit/pull/1124
      allowedVersions: '<2.0.0',
    },
    {
      matchPackageNames: ['gdal'],
      enabled: false,
    },
    {
      matchPackageNames: ['pyparsing'],
      // 3.3.3 has an infix_notation regression: https://github.com/pyparsing/pyparsing/issues/672
      allowedVersions: '!/^3\\.3\\.3$/',
    },
    {
      matchPackageNames: ['tailwindcss', '@tailwindcss/postcss'],
      // 4.3.4 drops daisyUI "join" rules from optimized builds: https://github.com/tailwindlabs/tailwindcss/issues/20668
      allowedVersions: '<4.3.4',
    },
  ],
}
